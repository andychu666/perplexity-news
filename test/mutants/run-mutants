// ── Runner ──────────────────────────────────────────────────────────
let shutdown = false;
let running = null;

function git(args) {
  return execFileSync("git", args, { cwd: ROOT, maxBuffer: 16 * 1024 * 1024 });
}

function refuse(message) {
  console.error(`REFUSED: ${message}`);
  process.exit(2);
}

function mutate(source, lineStarts, m) {
  const start = lineStarts[m.line - 1];
  const next = lineStarts[m.line] ?? source.length + 1;
  const index = start === undefined ? -1 : source.indexOf(m.from, start);
  if (index < 0 || index >= next) {
    throw new Error(`#${m.id} ${m.fn} L${m.line}: ${JSON.stringify(m.from)} does not start on line ${m.line}`);
  }
  return source.slice(0, index) + m.to + source.slice(index + m.from.length);
}

function compiles(source) {
  try {
    vm.compileFunction(source.replace(/^#!/, "//"), ["exports", "require", "module", "__filename", "__dirname"]);
    return true;
  } catch {
    return false;
  }
}

function killGroup(child) {
  try {
    process.kill(-child.pid, "SIGKILL");
  } catch { /* already gone */ }
}

// Runs the whole suite in its own process group, so a timeout or Ctrl-C can
// kill every test file and the children they spawn.
function runSuite() {
  return new Promise((resolve) => {
    const env = { ...process.env };
    delete env.NODE_TEST_CONTEXT;
    const child = spawn(process.execPath, ["--test", "--test-reporter=tap"], {
      cwd: ROOT,
      env,
      detached: true,
      stdio: ["ignore", "pipe", "ignore"],
    });
    running = child;
    let out = "";
    let timedOut = false;
    child.stdout.setEncoding("utf8");
    child.stdout.on("data", (chunk) => { out += chunk; });
    const timer = setTimeout(() => {
      timedOut = true;
      killGroup(child);
    }, TIMEOUT_MS);
    child.on("close", (status) => {
      clearTimeout(timer);
      running = null;
      const failed = [...out.matchAll(/^\s*not ok \d+ - (.+)$/gm)].map((match) => match[1].replace(ROOT + path.sep, ""));
      resolve({ status, timedOut, failed: [...new Set(failed)].sort() });
    });
  });
}

function classify(m, run) {
  if (run.timedOut || run.status !== 0) {
    let text = `killed (exit ${run.status})`;
    if (run.timedOut) text = "killed (timeout)";
    else if (run.failed.length) text = `killed by "${run.failed[0]}"${run.failed.length > 1 ? ` (+${run.failed.length - 1} more)` : ""}`;
    return { kind: "killed", text, stale: Boolean(m.note) };
  }
  if (m.note?.eq) return { kind: "equivalent", text: `equivalent: ${m.note.eq}` };
  if (m.note?.needs) return { kind: "needs", text: `needs code: ${m.note.needs}` };
  return { kind: "survived", text: "SURVIVED" };
}

async function main() {
  if (process.env.NODE_TEST_CONTEXT) return; // collected by a test runner by mistake
  const only = process.argv[2];

  const head = git(["rev-parse", "HEAD"]).toString().trim();
  const headBlob = git(["show", `HEAD:${REL}`]);
  if (!headBlob.equals(git(["show", `${PINNED}:${REL}`]))) {
    refuse(`${REL} at HEAD ${head.slice(0, 7)} differs from the pinned head ${PINNED.slice(0, 7)}`);
  }
  if (!fs.readFileSync(TARGET).equals(headBlob)) {
    refuse(`${REL} differs from HEAD; restore it (git checkout -- ${REL}) and run again`);
  }

  const original = headBlob.toString("utf8");
  const lineStarts = [0];
  for (let i = 0; i < original.length; i++) if (original[i] === "\n") lineStarts.push(i + 1);
  const seen = new Set();
  for (const m of MUTANTS) {
    m.source = mutate(original, lineStarts, m);
    if (!compiles(m.source)) throw new Error(`#${m.id} ${m.fn} L${m.line} "${m.what}": the mutated file does not compile`);
    const key = `${m.line}\0${m.from}\0${m.to}`;
    if (seen.has(key)) throw new Error(`#${m.id} ${m.fn} L${m.line}: duplicate mutant`);
    seen.add(key);
  }
  const selected = only ? MUTANTS.filter((m) => m.fn === only) : MUTANTS;
  if (selected.length === 0) refuse(`no mutants for ${JSON.stringify(only)}`);

  const baseline = await runSuite();
  if (baseline.timedOut || baseline.status !== 0) refuse(`the unmutated suite fails: ${baseline.failed.join("; ")}`);

  const started = Date.now();
  console.log(`HEAD ${head}; ${REL} is byte-identical to ${PINNED.slice(0, 7)}; ${selected.length} mutant(s)${only ? ` in ${only}` : ""}`);
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "news-mutants-"));
  const backup = path.join(tmp, "daily-news.js.orig");
  fs.copyFileSync(TARGET, backup);
  const rows = [];
  try {
    for (const m of selected) {
      if (shutdown) break;
      fs.writeFileSync(TARGET, m.source);
      let run;
      try {
        run = await runSuite();
      } finally {
        fs.copyFileSync(backup, TARGET);
      }
      if (shutdown) break;
      const row = { m, run, ...classify(m, run) };
      rows.push(row);
      const stale = row.stale ? `  [STALE NOTE: annotated ${m.note.eq ? "equivalent" : "needs code"}, but killed]` : "";
      console.log(`#${m.id} L${m.line} ${m.fn}: ${m.what} → ${row.text}${stale}`);
    }
  } finally {
    fs.copyFileSync(backup, TARGET);
  }
  if (!fs.readFileSync(TARGET).equals(git(["show", `HEAD:${REL}`]))) {
    refuse(`${REL} does not match HEAD after the run; the backup is ${backup}`);
  }
  fs.rmSync(tmp, { recursive: true, force: true });
  if (shutdown) {
    console.error(`Interrupted after ${rows.length} mutant(s); ${REL} is restored. No SUMMARY.`);
    process.exit(130);
  }

  const count = (kind) => rows.filter((row) => row.kind === kind).length;
  const needsCount = count("needs");
  const unexplained = count("survived");
  const stale = rows.filter((row) => row.stale).length;

  // Every test that killed something, and how many mutants only it kills.
  const kills = new Map();
  for (const row of rows) {
    for (const name of row.run.failed) {
      const entry = kills.get(name) ?? { all: 0, sole: 0 };
      entry.all++;
      if (row.run.failed.length === 1) entry.sole++;
      kills.set(name, entry);
    }
  }
  console.log("\nKILLS PER TEST (all / sole killer)");
  for (const [name, entry] of [...kills].sort((a, b) => a[0].localeCompare(b[0]))) {
    console.log(`  ${String(entry.all).padStart(3)} / ${String(entry.sole).padStart(3)}  ${name}`);
  }
  console.log("");
  for (const [symbol, text] of Object.entries(NEEDS_CODE)) {
    if (rows.some((row) => row.kind === "needs" && row.m.note.needs === symbol)) console.log(text);
  }
  if (stale) console.log(`${stale} STALE NOTE(S): an equivalent or needs-code mutant was killed; fix its note.`);
  console.log(`(${Math.round((Date.now() - started) / 1000)} s)`);
  console.log(`SUMMARY total ${rows.length} killed ${count("killed")} survived ${needsCount + unexplained} equivalent ${count("equivalent")} (survived: ${needsCount} needs code, ${unexplained} unexplained)${only ? ` [only ${only}]` : ""}`);
  process.exitCode = unexplained || stale ? 1 : 0;
}

for (const signal of ["SIGINT", "SIGTERM"]) {
  process.on(signal, () => {
    shutdown = true;
    if (running) killGroup(running);
  });
}

main().catch((err) => {
  console.error(`ERROR: ${err.message}`);
  process.exit(2);
});
